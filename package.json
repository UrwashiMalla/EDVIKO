    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node --watch-path=server/controllers --watch-path=server/models --watch-path=server/routes --watch-path=server/services --watch-path=server/config --watch-path=server/utils --watch-path=server/server.js server/server.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
